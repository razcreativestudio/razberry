---
import { cn } from '~/utils/merge'
const { class: className, ...props } = Astro.props
---

<ul class={cn('flex flex-wrap items-center gap-3', className)} {...props}>
  <li>
    <a
      href="https://www.instagram.com/raz_studio.id/"
      target="_blank"
      rel="noopener noreferrer"
      class="raz-control-btn !w-9 !h-9 text-sm"
      aria-label="Instagram RAZ Creative Studio"
      title="Instagram @raz_studio.id"
    >
      <i class="fab fa-instagram"></i>
    </a>
  </li>
  <li>
    <a
      href="https://www.youtube.com/@razcreativestudio"
      target="_blank"
      rel="noopener noreferrer"
      class="raz-control-btn !w-9 !h-9 text-sm"
      aria-label="YouTube RAZ Creative Studio"
      title="YouTube @razcreativestudio"
    >
      <i class="fab fa-youtube"></i>
    </a>
  </li>
  <li>
    <a
      href="https://www.tiktok.com/@razcreativestudio"
      target="_blank"
      rel="noopener noreferrer"
      class="raz-control-btn !w-9 !h-9 text-sm"
      aria-label="TikTok RAZ Creative Studio"
      title="TikTok @razcreativestudio"
    >
      <i class="fab fa-tiktok"></i>
    </a>
  </li>
  <li>
    <a
      href="https://github.com/razcreativestudio/razberry"
      target="_blank"
      rel="noopener noreferrer"
      class="raz-control-btn !w-9 !h-9 text-sm"
      aria-label="GitHub RAZBerry Browser"
      title="GitHub razcreativestudio/razberry"
    >
      <i class="fab fa-github"></i>
    </a>
  </li>
  <li>
    <a
      href="https://wa.me/6283173002527"
      target="_blank"
      rel="noopener noreferrer"
      class="raz-control-btn !w-9 !h-9 text-sm"
      aria-label="WhatsApp RAZ Creative Studio"
      title="WhatsApp +62 831 7300 2527"
    >
      <i class="fab fa-whatsapp"></i>
    </a>
  </li>
  <li>
    <a
      href="mailto:razcreativestudio@gmail.com"
      class="raz-control-btn !w-9 !h-9 text-sm"
      aria-label="Email RAZ Creative Studio"
      title="razcreativestudio@gmail.com"
    >
      <i class="fas fa-envelope"></i>
    </a>
  </li>
</ul>
