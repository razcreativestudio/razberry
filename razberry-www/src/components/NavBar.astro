---
import { Astronav, Dropdown, DropdownItems, MenuItems } from 'astro-navbar'
import Button from '~/components/Button.astro'
import ArrowRightIcon from '~/icons/ArrowRightIcon.astro'
import ChevronDownIcon from '~/icons/ChevronDownIcon.astro'
import DownloadIcon from '~/icons/DownloadIcon.astro'
import MenuIcon from '~/icons/MenuIcon.astro'
import { getLocale, getPath, getUI } from '~/utils/i18n'
import MobileMenu from './MobileMenu.astro'
import RAZLanguageSwitch from './RAZLanguageSwitch.astro'
import ThemeSwitch from './ThemeSwitch.astro'

const locale = getLocale(Astro)
const getLocalePath = getPath(locale)
const {
  components: {
    nav: { menu },
  },
} = getUI(locale)
---

<header id="main-header" class="raz-header">
  <Astronav>
    <MenuItems class="container grid w-full grid-cols-2 items-center gap-2 py-3 lg:grid lg:grid-cols-[auto_1fr_auto] lg:py-4">
      <a class="flex items-center gap-3 text-lg font-bold group" href={getLocalePath('/')}>
        <img
          src="/logo-razberry.png"
          alt="RAZBerry Browser"
          class="h-9 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
        />
        <div class="flex flex-col leading-none">
          <span class="text-base font-extrabold tracking-tight">
            <span class="pink-text">RAZ</span><span>Berry</span>
          </span>
          <span class="text-[10px] font-medium tracking-wider uppercase opacity-60">
            by RAZ Creative Studio
          </span>
        </div>
      </a>

      <div class="hidden items-center gap-7 place-self-center text-sm lg:flex">
        <a class="raz-nav-link" href={getLocalePath('/')}>Home</a>
        <Dropdown class="group">
          <button class="raz-nav-link flex items-center">
            <span>{menu.gettingStarted}</span>
            <ChevronDownIcon class="ml-1.5 size-4 transform transition-transform duration-200 group-open:rotate-180" />
          </button>
          <DropdownItems>
            <div class="navbar-dropdown">
              <a class="dropdown-item row-span-2" href={getLocalePath('/mods')}>
                <div class="dropdown-title">{menu.zenMods}</div>
                <div class="dropdown-description">{menu.zenModsDesc}</div>
                <Button isPrimary class="mt-auto !py-2.5 !px-4 !text-xs">
                  {menu.tryRAZBerryMods}
                  <ArrowRightIcon class="size-3.5" />
                </Button>
              </a>
              <a class="dropdown-item" href={getLocalePath('/release-notes')}>
                <div class="dropdown-title">{menu.releaseNotes}</div>
                <div class="dropdown-description">{menu.releaseNotesDesc}</div>
              </a>
              <a class="dropdown-item" href={getLocalePath('/welcome')}>
                <div class="dropdown-title">Welcome Tour</div>
                <div class="dropdown-description">Kenali fitur unggulan & tampilan awal RAZBerry Browser.</div>
              </a>
            </div>
          </DropdownItems>
        </Dropdown>

        <Dropdown class="group">
          <button class="raz-nav-link flex items-center">
            <span>{menu.usefulLinks}</span>
            <ChevronDownIcon class="ml-1.5 size-4 transform transition-transform duration-200 group-open:rotate-180" />
          </button>
          <DropdownItems>
            <div class="navbar-dropdown !grid-cols-1 gap-1">
              <a class="dropdown-item" href={getLocalePath('/about')}>
                <div class="dropdown-title">{menu.aboutUs}</div>
                <div class="dropdown-description">{menu.aboutUsDesc}</div>
              </a>
              <a class="dropdown-item" href={getLocalePath('/privacy-policy')}>
                <div class="dropdown-title">Privacy Policy</div>
                <div class="dropdown-description">Komitmen zero-telemetry & keamanan data pribadi Anda.</div>
              </a>
              <a class="dropdown-item" href="https://github.com/razcreativestudio/razberry" target="_blank">
                <div class="dropdown-title">{menu.github}</div>
                <div class="dropdown-description">{menu.githubDesc}</div>
              </a>
            </div>
          </DropdownItems>
        </Dropdown>

        <a class="raz-nav-link" href={getLocalePath('/donate')}>
          <span>{menu.donate}</span>
        </a>
      </div>

      <div class="flex items-center gap-3 place-self-end">
        <div class="hidden lg:block">
          <RAZLanguageSwitch />
        </div>
        <div id="theme-switcher" class="raz-control-btn">
          <ThemeSwitch label="Toggle theme" />
        </div>
        <Button href="/download" class="hidden lg:inline-flex !py-2.5 !px-5 !text-xs" isPrimary>
          <span>{menu.download}</span>
          <ArrowRightIcon class="size-4" />
        </Button>
        <label
          for="mobile-menu-toggle"
          class="text-dark cursor-pointer p-2 lg:hidden"
          aria-label="Open menu"
        >
          <MenuIcon class="h-6 w-6" />
        </label>
      </div>
    </MenuItems>
  </Astronav>
</header>

<MobileMenu />

<script>
  const header = document.getElementById('main-header')
  window.addEventListener('scroll', () => {
    if (!header) return
    if (window.scrollY > 24) {
      header.classList.add('scrolled')
    } else {
      header.classList.remove('scrolled')
    }
  })
</script>

<style>
  @reference '../styles/global.css';

  .navbar-dropdown {
    @apply border bg-paper absolute left-1/2 mt-3 grid !-translate-x-1/2 !transform grid-cols-2 gap-2 rounded-xl p-3 shadow-2xl;
    border-color: var(--color-border);
    min-width: 440px;

    & .dropdown-item {
      @apply flex cursor-pointer flex-col gap-1.5 rounded-lg p-3.5 transition-colors duration-200 select-none;

      &:hover {
        background: var(--color-pink-dim);
      }

      & .dropdown-title {
        @apply text-sm font-bold;
        color: var(--color-light-text);
      }

      & .dropdown-description {
        @apply text-xs leading-relaxed;
        color: var(--color-light-secondary);
      }
    }
  }
</style>
