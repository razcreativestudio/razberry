---
import Button from '~/components/Button.astro'
import ArrowRightIcon from '~/icons/ArrowRightIcon.astro'
import { getLocale, getPath, getUI } from '~/utils/i18n'

const locale = getLocale(Astro)
const getLocalePath = getPath(locale)
const {
  components: { footer },
} = getUI(locale)
---

<hr class="raz-separator" />

<footer
  id="footer"
  class="relative w-full pt-16 pb-10"
  style="background: var(--color-dark-secondary);"
  role="contentinfo"
  aria-label="Site footer"
>
  <div class="container">
    <div class="grid grid-cols-1 gap-10 pb-12 md:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1.1fr]">
      <!-- Kolom 1: Brand & Deskripsi ala webraz -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-4">
          <img
            src="/logo-razberry.png"
            alt="RAZBerry Logo"
            class="h-12 w-auto object-contain"
            loading="lazy"
          />
          <div class="h-8 w-px opacity-20" style="background: var(--color-light-text);"></div>
          <img
            src="/raz-creative-studio.svg"
            alt="RAZ Creative Studio"
            class="h-9 w-auto object-contain"
            loading="lazy"
          />
        </div>
        <p class="max-w-sm text-sm leading-relaxed" style="color: var(--color-light-secondary);">
          {footer.description} Dirancang dengan presisi oleh <strong class="pink-text">RAZ Creative Studio</strong> untuk pengalaman browsing yang cepat, fokus, dan aman.
        </p>
        <div class="pt-2">
          <Button href="/download" isPrimary class="!py-2.5 !px-5 !text-xs w-fit">
            <span>{footer.download}</span>
            <ArrowRightIcon class="size-3.5" />
          </Button>
        </div>
      </div>

      <!-- Kolom 2: Quick Links -->
      <div class="flex flex-col gap-3">
        <h4 class="text-sm font-bold tracking-wider uppercase pink-text">Quick Links</h4>
        <ul class="flex flex-col gap-2.5 text-sm" style="color: var(--color-light-secondary);">
          <li><a href={getLocalePath('/')} class="hover:text-coral transition-colors">Home</a></li>
          <li><a href={getLocalePath('/download')} class="hover:text-coral transition-colors">Download RAZBerry</a></li>
          <li><a href={getLocalePath('/about')} class="hover:text-coral transition-colors">{footer.teamAndContributors}</a></li>
          <li><a href={getLocalePath('/privacy-policy')} class="hover:text-coral transition-colors">{footer.privacyPolicy}</a></li>
          <li><a href={getLocalePath('/donate')} class="hover:text-coral transition-colors">Support / Donate</a></li>
        </ul>
      </div>

      <!-- Kolom 3: Explore RAZBerry -->
      <div class="flex flex-col gap-3">
        <h4 class="text-sm font-bold tracking-wider uppercase pink-text">{footer.getStarted}</h4>
        <ul class="flex flex-col gap-2.5 text-sm" style="color: var(--color-light-secondary);">
          <li><a href={getLocalePath('/mods')} class="hover:text-coral transition-colors">{footer.zenMods}</a></li>
          <li><a href={getLocalePath('/release-notes')} class="hover:text-coral transition-colors">{footer.releaseNotes}</a></li>
          <li><a href={getLocalePath('/shortcuts')} class="hover:text-coral transition-colors">Shortcut Key</a></li>
          <li><a href={getLocalePath('/welcome')} class="hover:text-coral transition-colors">Welcome Onboarding</a></li>
          <li><a href={getLocalePath('/whatsnew')} class="hover:text-coral transition-colors">What's New</a></li>
          <li><a href={getLocalePath('/download?twilight')} class="hover:text-coral transition-colors">{footer.twilight}</a></li>
        </ul>
      </div>

      <!-- Kolom 4: Ekosistem RAZ Creative Studio -->
      <div class="flex flex-col gap-3">
        <h4 class="text-sm font-bold tracking-wider uppercase pink-text">RAZ Ecosystem</h4>
        <ul class="flex flex-col gap-2.5 text-sm" style="color: var(--color-light-secondary);">
          <li>
            <a href="https://raz.web.id/" target="_blank" class="hover:text-coral transition-colors">
              RAZ Creative Studio <i class="fas fa-external-link-alt text-[10px] ml-1"></i>
            </a>
          </li>
          <li>
            <a href="https://raz.web.id/hubungi-raz.html" target="_blank" class="hover:text-coral transition-colors">
              Hubungi Kami <i class="fas fa-headset text-xs ml-1"></i>
            </a>
          </li>
          <li>
            <a href="mailto:razcreativestudio@gmail.com" class="hover:text-coral transition-colors">
              razcreativestudio@gmail.com
            </a>
          </li>
          <li>
            <a href="https://wa.me/6283173002527" target="_blank" class="hover:text-coral transition-colors">
              +62 831 7300 2527 (WhatsApp)
            </a>
          </li>
          <li>
            <a href="https://github.com/razcreativestudio/razberry" target="_blank" class="hover:text-coral transition-colors">
              GitHub Repository <i class="fab fa-github text-xs ml-1"></i>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Footer Bottom ala webraz -->
    <div
      class="flex flex-col items-center justify-between gap-4 border-t pt-6 text-xs sm:flex-row"
      style="border-color: var(--color-border); color: var(--color-light-secondary);"
    >
      <p>
        &copy; 2026 <strong class="pink-text">RAZBerry Browser</strong> by{' '}
        <a href="https://raz.web.id/" target="_blank" class="underline hover:text-coral">
          RAZ Creative Studio
        </a>
        . All rights reserved.
      </p>
      <div class="flex items-center gap-3">
        <a
          href="https://www.instagram.com/raz_studio.id/"
          target="_blank"
          aria-label="Instagram"
          class="raz-control-btn !w-9 !h-9 text-sm"
        >
          <i class="fab fa-instagram"></i>
        </a>
        <a
          href="https://www.youtube.com/@razcreativestudio"
          target="_blank"
          aria-label="YouTube"
          class="raz-control-btn !w-9 !h-9 text-sm"
        >
          <i class="fab fa-youtube"></i>
        </a>
        <a
          href="https://www.tiktok.com/@razcreativestudio"
          target="_blank"
          aria-label="TikTok"
          class="raz-control-btn !w-9 !h-9 text-sm"
        >
          <i class="fab fa-tiktok"></i>
        </a>
        <a
          href="https://github.com/razcreativestudio/razberry"
          target="_blank"
          aria-label="GitHub"
          class="raz-control-btn !w-9 !h-9 text-sm"
        >
          <i class="fab fa-github"></i>
        </a>
      </div>
    </div>
  </div>
</footer>
