---
import Image from 'astro/components/Image.astro'
import ComImage from '~/assets/ComImage.png'
import Button from '~/components/Button.astro'
import CheckIcon from '~/icons/CheckIcon.astro'
import GitHubIcon from '~/icons/GitHubIcon.astro'
import { getLocale, getUI } from '~/utils/i18n'
import SocialMediaStrip from './SocialMediaStrip.astro'

const locale = getLocale(Astro)
const {
  routes: {
    index: { community },
  },
} = getUI(locale)
---

<section
  id="community"
  class="relative flex w-full flex-col items-center gap-8 py-16 text-start md:text-center lg:py-28"
>
  <span class="raz-section-label">Community & Contact</span>
  <h2 class="text-3xl font-extrabold sm:text-5xl">
    {community.title.map(title =>
      title !== '\n' ? (
        <span>{title} </span>
      ) : (
        <br class="hidden md:block" />
      )
    )}
  </h2>
  <p class="max-w-2xl text-base" style="color: var(--color-light-secondary);">
    {community.description}
  </p>

  <div class="flex w-full flex-wrap items-center gap-4 sm:gap-8 md:justify-center">
    <Button href="https://github.com/razcreativestudio/razberry" localePath={false} target="_blank">
      <GitHubIcon class="size-4" />
      <span>{community.lists.freeAndOpenSource.title}</span>
    </Button>
    <div class="flex items-center gap-2.5 text-sm font-semibold">
      <CheckIcon class="size-4 pink-text" />
      <span>{community.lists.simpleYetPowerful.title}</span>
    </div>
    <div class="flex items-center gap-2.5 text-sm font-semibold">
      <CheckIcon class="size-4 pink-text" />
      <span>{community.lists.privateAndAlwaysUpToDate.title}</span>
    </div>
  </div>

  <!-- Info Kontak Resmi RAZ Creative Studio ala webraz -->
  <div class="grid w-full max-w-4xl grid-cols-1 gap-4 sm:grid-cols-3 text-left">
    <a href="mailto:razcreativestudio@gmail.com" class="raz-card flex items-center gap-4 p-5">
      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl" style="background: var(--color-pink-dim); color: var(--color-pink-accent);">
        <i class="fas fa-envelope"></i>
      </div>
      <div class="min-w-0">
        <div class="text-xs uppercase tracking-wider opacity-60">Email Resmi</div>
        <div class="truncate text-sm font-bold">razcreativestudio@gmail.com</div>
      </div>
    </a>

    <a href="https://wa.me/6283173002527" target="_blank" rel="noopener noreferrer" class="raz-card flex items-center gap-4 p-5">
      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl" style="background: var(--color-pink-dim); color: var(--color-pink-accent);">
        <i class="fab fa-whatsapp text-lg"></i>
      </div>
      <div class="min-w-0">
        <div class="text-xs uppercase tracking-wider opacity-60">WhatsApp / Telepon</div>
        <div class="truncate text-sm font-bold">+62 831 7300 2527</div>
      </div>
    </a>

    <a href="https://raz.web.id/hubungi-raz.html" target="_blank" rel="noopener noreferrer" class="raz-card flex items-center gap-4 p-5">
      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl" style="background: var(--color-pink-dim); color: var(--color-pink-accent);">
        <i class="fas fa-globe"></i>
      </div>
      <div class="min-w-0">
        <div class="text-xs uppercase tracking-wider opacity-60">RAZ Creative Studio</div>
        <div class="truncate text-sm font-bold">raz.web.id • Indonesia</div>
      </div>
    </a>
  </div>

  <div class="flex flex-col items-center gap-3">
    <span class="text-xs font-semibold uppercase tracking-widest opacity-60">Ikuti Sosial Media Kami</span>
    <SocialMediaStrip />
  </div>

  <div
    class="mt-4 w-full max-w-5xl overflow-hidden rounded-2xl border p-2"
    style="background: var(--color-dark-secondary); border-color: var(--color-border); box-shadow: var(--shadow-card);"
  >
    <Image
      src={ComImage}
      alt={community.images.community.alt}
      class="w-full rounded-xl"
    />
  </div>
</section>
