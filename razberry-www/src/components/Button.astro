---
import { getLocale, getPath } from '~/utils/i18n'

const locale = getLocale(Astro)
const getLocalePath = getPath(locale)
const {
  class: className,
  isPrimary,
  isAlert,
  isBordered,
  href,
  id,
  extra,
  localePath = true,
  ...props
} = Astro.props

const variantClass = isPrimary
  ? 'raz-cta-primary'
  : isAlert
    ? 'bg-red-500/20 border border-red-500/40 text-red-300 rounded-lg px-6 py-3'
    : 'raz-cta-secondary'
---

{href ? (
  <a
    id={id}
    {...extra}
    href={localePath ? getLocalePath(href) : href}
    class:list={[variantClass, className]}
    {...props}
  >
    <slot />
  </a>
) : (
  <button
    id={id}
    {...extra}
    class:list={[variantClass, className]}
    {...props}
  >
    <slot />
  </button>
)}
<style>
  button,
  a {
    &[disabled] {
      cursor: not-allowed;
      opacity: 0.5;
    }
  }
</style>
