---
import { getLocale, getPath, getUI } from '~/utils/i18n'
import RAZLanguageSwitch from './RAZLanguageSwitch.astro'

const locale = getLocale(Astro)
const getLocalePath = getPath(locale)
const {
  components: {
    nav: { menu },
  },
} = getUI(locale)
---

<input type="checkbox" id="mobile-menu-toggle" class="peer sr-only lg:hidden" aria-hidden="true" />

<div
  id="mobile-menu"
  class="bg-paper fixed inset-y-0 right-0 z-50 w-72 translate-x-full transform border-l shadow-2xl transition-transform duration-300 peer-checked:translate-x-0 lg:hidden"
  style="border-color: var(--color-border);"
>
  <div class="flex items-center justify-between border-b px-5 py-4" style="border-color: var(--color-border);">
    <div class="text-lg font-extrabold">
      <span class="pink-text">RAZ</span>Berry
    </div>
    <label for="mobile-menu-toggle" class="text-dark cursor-pointer p-2">
      <span class="sr-only">Close menu</span>
      <i class="fas fa-times text-lg"></i>
    </label>
  </div>
  <nav class="px-5 py-4">
    <ul class="space-y-5 text-sm">
      <li>
        <a href={getLocalePath('/')} class="block font-bold hover:text-coral">Home</a>
      </li>
      <li>
        <div class="mb-2 text-xs font-bold uppercase tracking-wider pink-text">{menu.gettingStarted}</div>
        <ul class="ml-3 space-y-2.5">
          <li><a href={getLocalePath('/mods')} class="block hover:text-coral">{menu.zenMods}</a></li>
          <li><a href={getLocalePath('/release-notes')} class="block hover:text-coral">{menu.releaseNotes}</a></li>
          <li><a href={getLocalePath('/shortcuts')} class="block hover:text-coral">{menu.shortcuts}</a></li>
          <li><a href={getLocalePath('/welcome')} class="block hover:text-coral">Welcome Tour</a></li>
        </ul>
      </li>
      <li>
        <div class="mb-2 text-xs font-bold uppercase tracking-wider pink-text">{menu.usefulLinks}</div>
        <ul class="ml-3 space-y-2.5">
          <li><a href={getLocalePath('/about')} class="block hover:text-coral">{menu.aboutUs}</a></li>
          <li><a href={getLocalePath('/privacy-policy')} class="block hover:text-coral">Privacy Policy</a></li>
          <li><a href="https://raz.web.id/hubungi-raz.html" target="_blank" class="block hover:text-coral">Hubungi RAZ Studio</a></li>
          <li><a href="https://github.com/razcreativestudio/razberry" target="_blank" class="block hover:text-coral">{menu.github}</a></li>
        </ul>
      </li>
      <li class="pt-1">
        <div class="mb-2 text-xs font-bold uppercase tracking-wider pink-text">{menu.language}</div>
        <RAZLanguageSwitch compact />
      </li>
      <li class="pt-2 space-y-2">
        <a href={getLocalePath('/donate')} class="raz-cta-secondary w-full !py-2.5 !text-xs">
          {menu.donate}
        </a>
        <a href={getLocalePath('/download')} class="raz-cta-primary w-full !py-2.5 !text-xs">
          {menu.download}
        </a>
      </li>
    </ul>
  </nav>
</div>

<label
  for="mobile-menu-toggle"
  class="pointer-events-none fixed inset-0 z-40 bg-black opacity-0 transition-opacity duration-300 peer-checked:pointer-events-auto peer-checked:opacity-60"
  aria-hidden="true"
></label>
