---
interface Props {
  title: string
  description?: string
  ogImage?: string
  isHome?: boolean
  redirect?: string
}

const { title, description, ogImage, isHome, redirect } = Astro.props
const defaultDescription =
  'RAZBerry Browser oleh RAZ Creative Studio — Peramban web modern bertema Black-Pink Raspberry yang cepat, aman, bebas distraksi, dan menjaga privasi Anda.'

import '@fontsource/bricolage-grotesque/400.css'
import '@fontsource/bricolage-grotesque/500.css'
import '@fontsource/bricolage-grotesque/600.css'
import '../styles/global.css'
import Footer from '~/components/Footer.astro'
import NavBar from '~/components/NavBar.astro'
import { getLocale } from '~/utils/i18n'

const locale = getLocale(Astro)
---

<script is:inline data-cfasync="false">
  const theme = (() => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme') ?? 'dark'
    }
    return 'dark'
  })()

  document.documentElement.setAttribute('data-theme', theme === 'light' ? 'light' : 'dark')
</script>

<html lang={locale === 'id-oke' ? 'id' : locale}>
  <head>
    <meta charset="UTF-8" />
    {redirect ? <meta http-equiv="refresh" content={`0;url=${redirect}`} /> : null}
    <meta name="description" content={description ?? defaultDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="RAZ Creative Studio" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-0.xml" />

    <!-- Google Fonts: Inter & Poppins (Standar Web RAZ Creative Studio) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Font Awesome 6.5.0 -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />

    {isHome && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'SoftwareApplication',
          name: 'RAZBerry Browser',
          applicationCategory: 'BrowserApplication',
          operatingSystem: 'Windows, macOS, Linux',
          url: 'https://razberry.it-raz.com/',
          author: {
            '@type': 'Organization',
            name: 'RAZ Creative Studio',
            url: 'https://raz.web.id/',
          },
        })}
      ></script>
    )}

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="theme-color" content="#FF4081" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="RAZBerry Browser by RAZ Creative Studio" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage ?? 'https://razberry.it-raz.com/share-pic.png'} />
    <meta property="og:description" content={description ?? defaultDescription} />
    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <!-- RSS Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RAZBerry Browser Release Notes"
      href={`${Astro.url.origin}/feed.xml`}
    />

    <script>
      // eslint-disable-next-line no-console
      console.log(
        '%cRAZBerry Browser%c\nDesigned by RAZ Creative Studio — https://razberry.it-raz.com/',
        'color: #FF4081; font-size: 24px; font-weight: bolder; font-family: "Inter", sans-serif; margin-top: 16px;',
        'color: #FDF0F5; font-size: 13px; font-family: "Inter", sans-serif; margin-bottom: 16px;'
      )
    </script>
  </head>
  <body class="bg-paper text-dark min-h-screen overflow-x-hidden antialiased">
    <!-- Ambient Floating Raspberry Particles ala webraz -->
    <div class="raz-particle pointer-events-none" style="width:320px;height:320px;top:8%;left:-100px;"></div>
    <div class="raz-particle pointer-events-none" style="width:260px;height:260px;bottom:14%;right:-80px;"></div>

    <NavBar />
    <div class="pt-20">
      <slot />
    </div>
    <Footer />
  </body>
</html>
