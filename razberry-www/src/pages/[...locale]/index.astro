---
import Community from '~/components/Community.astro'
import Features from '~/components/Features.astro'
import Hero from '~/components/Hero.astro'
import Layout from '~/layouts/Layout.astro'
import { getLocale, getUI } from '~/utils/i18n'
export { getStaticPaths } from '~/utils/i18n'

const locale = getLocale(Astro)
const {
  layout,
  routes: {
    index: { whySection },
  },
} = getUI(locale)
---

<Layout title={layout.index.title} description={layout.index.description} isHome>
  <Hero />

  <hr class="raz-separator" />

  <!-- Section Keunggulan RAZBerry ala webraz About & USP Grid -->
  <section class="py-20 lg:py-24">
    <div class="container">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div class="space-y-5">
          <span class="raz-section-label">{whySection.label}</span>
          <h2 class="text-3xl font-extrabold sm:text-4xl leading-tight">
            {whySection.titleLine1}<br />
            <span class="pink-text">{whySection.titleLine2}</span>
          </h2>
          <p class="text-base leading-relaxed" style="color: var(--color-light-secondary);" set:html={whySection.description} />
          <div class="grid grid-cols-3 gap-4 pt-4">
            <div class="raz-card p-4 text-center">
              <div class="text-2xl font-extrabold pink-text">0%</div>
              <div class="text-xs uppercase tracking-wider mt-1 opacity-75">{whySection.stats.telemetry}</div>
            </div>
            <div class="raz-card p-4 text-center">
              <div class="text-2xl font-extrabold pink-text">100%</div>
              <div class="text-xs uppercase tracking-wider mt-1 opacity-75">{whySection.stats.openSource}</div>
            </div>
            <div class="raz-card p-4 text-center">
              <div class="text-2xl font-extrabold pink-text">All-in-One</div>
              <div class="text-xs uppercase tracking-wider mt-1 opacity-75">{whySection.stats.productivity}</div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="raz-card p-6 space-y-2.5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg" style="background: var(--color-pink-dim); color: var(--color-pink-accent);">
              <i class="fas fa-layer-group"></i>
            </div>
            <h3 class="text-lg font-bold">{whySection.cards.workspacesTitle}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-light-secondary);">
              {whySection.cards.workspacesDesc}
            </p>
          </div>
          <div class="raz-card p-6 space-y-2.5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg" style="background: var(--color-pink-dim); color: var(--color-pink-accent);">
              <i class="fas fa-columns"></i>
            </div>
            <h3 class="text-lg font-bold">{whySection.cards.splitViewTitle}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-light-secondary);">
              {whySection.cards.splitViewDesc}
            </p>
          </div>
          <div class="raz-card p-6 space-y-2.5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg" style="background: var(--color-pink-dim); color: var(--color-pink-accent);">
              <i class="fas fa-wand-magic-sparkles"></i>
            </div>
            <h3 class="text-lg font-bold">{whySection.cards.modsTitle}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-light-secondary);">
              {whySection.cards.modsDesc}
            </p>
          </div>
          <div class="raz-card p-6 space-y-2.5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg" style="background: var(--color-pink-dim); color: var(--color-pink-accent);">
              <i class="fas fa-shield-halved"></i>
            </div>
            <h3 class="text-lg font-bold">{whySection.cards.privacyTitle}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-light-secondary);">
              {whySection.cards.privacyDesc}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="raz-separator" />

  <main class="container">
    <Features />
  </main>

  <hr class="raz-separator" />

  <main class="container">
    <Community />
  </main>
</Layout>
