---
import Community from '~/components/Community.astro'
import Features from '~/components/Features.astro'
import Hero from '~/components/Hero.astro'
import Sponsors from '~/components/Sponsors.astro'
import Layout from '~/layouts/Layout.astro'
import { getLocale, getUI } from '~/utils/i18n'
export { getStaticPaths } from '~/utils/i18n'

const locale = getLocale(Astro)
const { layout } = getUI(locale)
---

<Layout title={layout.index.title} description={layout.index.description} isHome>
  <Hero />

  <hr class="raz-separator" />

  <!-- Section Keunggulan RAZBerry ala webraz About & USP Grid -->
  <section class="py-20 lg:py-24">
    <div class="container">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div class="space-y-5">
          <span class="raz-section-label">Why RAZBerry</span>
          <h2 class="text-3xl font-extrabold sm:text-4xl leading-tight">
            Teknologi Browser Modern,<br />
            <span class="pink-text">Fokus & Privasi Maksimal</span>
          </h2>
          <p class="text-base leading-relaxed" style="color: var(--color-light-secondary);">
            RAZBerry Browser dibangun oleh <strong>RAZ Creative Studio</strong> di atas fondasi open-source Firefox/Gecko dengan desain antarmuka bertema Black-Pink Raspberry yang tegas, bersih, dan nyaman untuk sesi kerja panjang.
          </p>
          <div class="grid grid-cols-3 gap-4 pt-4">
            <div class="raz-card p-4 text-center">
              <div class="text-2xl font-extrabold pink-text">0%</div>
              <div class="text-xs uppercase tracking-wider mt-1 opacity-75">Telemetry</div>
            </div>
            <div class="raz-card p-4 text-center">
              <div class="text-2xl font-extrabold pink-text">100%</div>
              <div class="text-xs uppercase tracking-wider mt-1 opacity-75">Open Source</div>
            </div>
            <div class="raz-card p-4 text-center">
              <div class="text-2xl font-extrabold pink-text">All-in-One</div>
              <div class="text-xs uppercase tracking-wider mt-1 opacity-75">Productivity</div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="raz-card p-6 space-y-2.5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg" style="background: var(--color-pink-dim); color: var(--color-pink-accent);">
              <i class="fas fa-layer-group"></i>
            </div>
            <h3 class="text-lg font-bold">Workspaces & Vertical Tabs</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-light-secondary);">
              Pisahkan proyek kerja, riset, dan hiburan dengan ruang kerja rapi dan tab vertikal lega.
            </p>
          </div>
          <div class="raz-card p-6 space-y-2.5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg" style="background: var(--color-pink-dim); color: var(--color-pink-accent);">
              <i class="fas fa-columns"></i>
            </div>
            <h3 class="text-lg font-bold">Built-in Split View</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-light-secondary);">
              Bandingkan dua hingga beberapa tab berdampingan dalam satu jendela tanpa ekstensi tambahan.
            </p>
          </div>
          <div class="raz-card p-6 space-y-2.5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg" style="background: var(--color-pink-dim); color: var(--color-pink-accent);">
              <i class="fas fa-wand-magic-sparkles"></i>
            </div>
            <h3 class="text-lg font-bold">RAZBerry Mods</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-light-secondary);">
              Kustomisasi tampilan dan perilaku browser sesuka hati lewat ekosistem Mods terkurasi.
            </p>
          </div>
          <div class="raz-card p-6 space-y-2.5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg" style="background: var(--color-pink-dim); color: var(--color-pink-accent);">
              <i class="fas fa-shield-halved"></i>
            </div>
            <h3 class="text-lg font-bold">Privacy First</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-light-secondary);">
              Tanpa pelacakan, tanpa telemetri tersembunyi, dan proteksi pelacak aktif secara bawaan.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="raz-separator" />

  <main class="container">
    <Features />
  </main>

  <hr class="raz-separator" />

  <main class="container">
    <Sponsors showSponsors />
    <Community />
  </main>
</Layout>
