---
import Features from '~/components/Features.astro'
import Layout from '~/layouts/Layout.astro'
import { getLocale, getUI } from '~/utils/i18n'
export { getStaticPaths } from '~/utils/i18n'

const locale = getLocale(Astro)
const {
  routes: { welcome },
} = getUI(locale)
---

<Layout
  title="Welcome to RAZBerry Browser - By RAZ Creative Studio"
  description="Welcome to RAZBerry Browser, crafted with care by RAZ Creative Studio. Fast, privacy-focused, and beautifully designed."
>
  <section class="relative overflow-hidden py-16 lg:py-24">
    <div class="container relative z-10 flex flex-col items-center text-center">
      <div class="raz-hero-badge mb-8 animate-fadeIn">
        <span class="raz-badge-dot"></span>
        <span>Official Onboarding • RAZBerry Browser</span>
      </div>

      <!-- Logos Container (Transparent, No Background) -->
      <div class="mb-8 flex items-center justify-center gap-6 sm:gap-10">
        <img
          src="/logo-razberry.png"
          alt="RAZBerry Browser Logo"
          class="h-24 w-24 sm:h-32 sm:w-32 object-contain drop-shadow-xl transition-transform duration-300 hover:scale-105"
          width="128"
          height="128"
        />
        <div class="h-14 w-px opacity-25" style="background: var(--color-pink-accent);"></div>
        <img
          src="/raz-creative-studio.svg"
          alt="RAZ Creative Studio Logo"
          class="h-16 sm:h-20 w-auto object-contain transition-transform duration-300 hover:scale-105"
          width="240"
          height="80"
        />
      </div>

      <!-- Main Headline -->
      <div class="max-w-3xl space-y-4">
        <h1 class="text-4xl font-extrabold tracking-tight sm:text-6xl">
          Welcome to <span class="pink-text pink-shimmer">RAZBerry Browser</span>
        </h1>
        <p class="text-xl font-semibold sm:text-2xl" style="color: var(--color-light-secondary);">
          By <span style="color: var(--color-light-text);">RAZ Creative Studio</span>
        </p>
        <p class="mx-auto max-w-xl text-base sm:text-lg" style="color: var(--color-light-secondary);">
          Nikmati pengalaman berselancar di web yang lebih tenang, cepat, berfokus privasi, dan bebas distraksi dengan tema eksklusif Black-Pink Raspberry.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="#features" class="raz-cta-primary">
          <span>Mulai Menjelajah</span>
          <i class="fas fa-arrow-right"></i>
        </a>
        <a href="/mods" class="raz-cta-secondary">
          <span>Lihat RAZBerry Mods</span>
        </a>
      </div>
    </div>
  </section>

  <hr class="raz-separator" />

  <main class="container">
    <Features titles={welcome.title} />
  </main>
</Layout>
